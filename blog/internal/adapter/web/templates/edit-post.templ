package templates

import "github.com/roman-duke/templ-htmx-warmup/blog/internal/adapter/web/components/field"
import "github.com/roman-duke/templ-htmx-warmup/blog/internal/adapter/web/components/input"
import "github.com/roman-duke/templ-htmx-warmup/blog/internal/adapter/web/components/textarea"
import "github.com/roman-duke/templ-htmx-warmup/blog/internal/adapter/web/components/button"
import "github.com/roman-duke/templ-htmx-warmup/blog/internal/core"
import "slices"
import "fmt"
import "time"

type EditPostInput = core.CreatePostInput

type FormValues struct {
	Id        string
	Title     string
	Content   string
	CreatedAt time.Time
	UpdatedAt time.Time
}

type EditPostProps struct {
	Errs core.ValidationErrors
	// Post   *core.Post
	Values *FormValues
}

// this is reused for the case of creation and also edit
// we just check what the pointer variable references
templ EditPost(props EditPostProps) {
	{{
		//================== necessary destructuring =================//
		errs, in := props.Errs, props.Values
		// ========================================================== //

		postId, titleVal, contentVal, createdAt, updatedAt := in.Id, in.Title, in.Content, in.CreatedAt, in.UpdatedAt
	}}
	<div id="form-page" class="h-full w-full mx-auto max-w-2xl flex flex-col justify-center gap-4">
		<div class="flex justify-between">
			<a href="/">
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeLg,
					Class:   "px-3 py-4 cursor-pointer",
				}) {
					Back
				}
			</a>
			if postId != "" {
				@button.Button(button.Props{
					Variant: button.VariantDestructive,
					Size:    button.SizeLg,
					Class:   "px-3 py-4 cursor-pointer",
					Attributes: templ.Attributes{
						"hx-delete":  fmt.Sprintf("/posts/%s", in.Id),
						"hx-confirm": "Delete this post? This can't be undone.",
					},
				}) {
					Delete Post
				}
			}
		</div>
		<div class="w-full rounded-lg border border-border bg-card text-card-foreground shadow-sm">
			<form
				class="flex flex-col gap-6 p-6"
				if postId != "" {
					hx-patch={ fmt.Sprintf("/posts/%s", postId) }
					hx-target="#form-page"
					hx-swap="outerHTML"
				} else {
					hx-post="/posts"
          hx-target="#form-page"
          hx-swap="outerHTML"
				}
			>
				@field.Group() {
					@field.Set() {
						@field.Legend(field.LegendProps{Class: "data-[variant=legend]:text-lg"}) {
							if postId != "" {
								Edit Post
							} else {
								New Post
							}
						}
						@field.Description(field.DescriptionProps{Class: "text-sm"}) {
							if postId != "" {
								Update this entry. Content is written in Markdown and rendered to HTML when published.
							} else {
								Write a new entry for your blog. Content is written in Markdown and rendered to HTML when published.
							}
						}
						if postId != "" {
							<div class="flex flex-col justify-between text-xs text-muted-foreground">
								<span>
									<strong>First published:</strong> { createdAt.Format("Jan 2, 2006 at 3:04 PM") }
								</span>
								<span>
									<strong>Last edited:</strong> { updatedAt.Format("Jan 2, 2006 at 3:04 PM") }
								</span>
							</div>
						}
					}
					@field.Group() {
						@field.Field() {
							@field.Label(field.LabelProps{For: "post-title"}) {
								Title
							}
							@input.Input(input.Props{ID: "post-title", Name: "title", Placeholder: "Any physics topic...", Value: titleVal})
							@field.Description() {
								Shown in the sidebar and as the post heading. Must be unique.
							}
							@fieldRenderer("title", errs)
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "post-content"}) {
								Content
							}
							@textarea.Textarea(textarea.Props{ID: "post-content", Name: "content", Placeholder: "Write your post in markdown...",
								Class: "resize-none h-40", Value: contentVal})
							@field.Description() {
								Supports markdown. Requires at least 50 characters...
							}
							@fieldRenderer("content", errs)
						}
					}
				}
				<div class="flex items-center justify-end gap-2">
					@button.Button(button.Props{Variant: "outline", Type: "reset", Size: button.SizeLg, Class: "px-3 py-4"}) {
						Clear
					}
					@button.Button(button.Props{Variant: "default", Type: "submit", Size: button.SizeLg, Class: "px-3 py-4"}) {
						if postId != "" {
							Update Post
						} else {
							Publish Post
						}
					}
				</div>
			</form>
		</div>
	</div>
}

templ fieldRenderer(key string, source core.ValidationErrors) {
	// we extract a pointer to the error from the source based on the key that is
	// provided. If none is found, then our variable holds nil and this serves as
	// as indication of the absence of an error for this field
	{{
		var err *core.FieldError
		errIdx := slices.IndexFunc(source, func(err core.FieldError) bool {
			return err.Field == key
		})

		if errIdx != -1 {
			err = &source[errIdx]
		}
	}}
	if err != nil {
		@field.Error() {
			{ err.Message }
		}
		// // <p class="text-red-500 text-sm">
		// { err.Message }
		// // </p>
	}
}
